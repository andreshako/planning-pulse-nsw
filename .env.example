# NSW Online DA Data API access
#
# This API is broker-mediated, not self-service: request access by emailing
# data.broker@environment.nsw.gov.au and referencing the "Online DA Data API"
# dataset (https://www.data.nsw.gov.au/data/dataset/online-da-data-api).
# The Data Broker issues the endpoint URL and an API key/token directly to you;
# neither is published anywhere in the official documentation or in this repo.
#
# Never commit a real .env file. Copy this file to .env and fill in real values locally.

# Full request URL for the DA search endpoint, as provided by the Data Broker.
DA_API_URL=

# API key / token issued by the Data Broker.
DA_API_KEY=

# HTTP header used to send the API key. Not documented publicly — confirm the
# exact header name with the Data Broker when you receive access. "Authorization"
# is assumed as a starting point only.
DA_API_AUTH_HEADER=Authorization

# --- Sample scope (kept small and conservative for this iteration) ---

# Optional: restrict to a single council for a smaller, more predictable sample.
# See Appendix 1 of the DA Open APIs data dictionary for valid values, e.g.
# "PENRITH CITY COUNCIL".
DA_COUNCIL_NAME=

# Optional lodgement date window, format YYYY-MM-DD. If unset, the script
# defaults to the last 7 days.
DA_LODGEMENT_DATE_FROM=
DA_LODGEMENT_DATE_TO=

# Maximum number of records loaded into DuckDB from the fetched response.
DA_RECORD_LIMIT=50

# --- Local storage ---
RAW_DATA_DIR=data/raw
DUCKDB_PATH=data/planning_pulse.duckdb
