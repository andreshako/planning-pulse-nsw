# NSW Online DA Data API access
#
# The API is public: no credentials, API key, or UAT environment are needed.
# The settings below are all optional local overrides; the script runs with
# sensible defaults if you never copy this file to .env.

# Number of records to fetch in this iteration's single-page sample.
# Capped at 100 by the script regardless of this value (no full pagination yet).
DA_SAMPLE_SIZE=50

# Optional: only fetch applications last updated on or after this date
# (format YYYY-MM-DD). Sent as the ApplicationLastUpdatedFrom filter.
# If unset, the request is unfiltered (default).
DA_APPLICATION_LAST_UPDATED_FROM=

# Number of consecutive pages to fetch (PageNumber 1..N), 100 records per
# page. Default 1 (normal single-page sample, sized by DA_SAMPLE_SIZE
# above). Set higher for a larger local snapshot; capped at 50 by the
# script regardless of this value (max 5,000 records, no full API history).
# Stops early if the API reports fewer pages are available for the filter.
DA_PAGE_COUNT=1

# --- Local storage ---
RAW_DATA_DIR=data/raw
DUCKDB_PATH=data/planning_pulse.duckdb
